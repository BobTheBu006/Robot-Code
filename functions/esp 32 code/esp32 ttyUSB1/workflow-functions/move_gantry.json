{
    "manifest":  {
                     "id":  "move_gantry",
                     "display_name":  "Move Gantry XY",
                     "category":  "Robot Actions",
                     "description":  "Move the XY gantry to an absolute position from the calibrated origin.",
                     "version":  "0.3.0",
                     "inputs":  [
                                    {
                                        "key":  "tool_port",
                                        "label":  "Selected ESP32",
                                        "type":  "file/path",
                                        "description":  "Connected ESP32 board that should receive the XY gantry command.",
                                        "required":  true,
                                        "default":  "/dev/ttyUSB1",
                                        "placeholder":  "/dev/ttyUSB1"
                                    },
                                    {
                                        "key":  "x_cm",
                                        "label":  "X Position (cm)",
                                        "type":  "number",
                                        "description":  "Target X position measured from the calibrated origin.",
                                        "required":  true,
                                        "default":  0
                                    },
                                    {
                                        "key":  "y_cm",
                                        "label":  "Y Position (cm)",
                                        "type":  "number",
                                        "description":  "Target Y position measured from the calibrated origin.",
                                        "required":  true,
                                        "default":  0
                                    },
                                    {
                                        "key":  "speed_profile",
                                        "label":  "Speed Profile",
