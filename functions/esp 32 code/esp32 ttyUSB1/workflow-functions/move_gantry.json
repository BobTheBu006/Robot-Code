                                        "required":  true,
                                        "default":  "normal",
                                        "options":  [
                                                        {
                                                            "label":  "Slow",
                                                            "value":  "slow"
                                                        },
                                                        {
                                                            "label":  "Normal",
                                                            "value":  "normal"
                                                        },
                                                        {
                                                            "label":  "Fast",
                                                            "value":  "fast"
                                                        }
                                                    ]
                                    }
                                ],
                     "advanced_inputs":  [
                                             {
                                                 "key":  "x_step_pin",
