                                                 "required":  false,
                                                 "default":  "4",
                                                 "advanced":  true,
                                                 "options":  [
                                                                 {
                                                                     "label":  "2 Limit Switches",
                                                                     "value":  "2"
                                                                 },
                                                                 {
                                                                     "label":  "4 Limit Switches",
                                                                     "value":  "4"
                                                                 }
                                                             ]
                                             },
                                             {
                                                 "key":  "z_left_min_limit_pin",
                                                 "label":  "Left Z Min Limit Pin",
                                                 "type":  "number",
                                                 "description":  "GPIO pin for the left Z minimum/home limit switch.",
                                                 "required":  false,
                                                 "default":  12,
                                                 "advanced":  true
