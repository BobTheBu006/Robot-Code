                                             {
                                                 "key":  "z_left_max_limit_pin",
                                                 "label":  "Left Z Max Limit Pin",
                                                 "type":  "number",
                                                 "description":  "GPIO pin for the left Z maximum limit switch.",
                                                 "required":  false,
                                                 "default":  13,
                                                 "advanced":  true
