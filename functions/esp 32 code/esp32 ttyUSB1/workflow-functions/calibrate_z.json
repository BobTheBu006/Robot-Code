                                                                   "id":  "z-right-ms1",
                                                                   "signal":  "micro_step_1",
                                                                   "gpio":  "-"
                                                               },
                                                               {
                                                                   "id":  "z-right-ms2",
                                                                   "signal":  "micro_step_2",
                                                                   "gpio":  "-"
                                                               },
                                                               {
