{
  "manifest": {
    "id": "calibrate_z",
    "display_name": "Calibrate Gantry Z",
    "category": "Robot Actions",
    "description": "Home both Z axes against their limit switches and register the travel lengths in centimeters.",
    "version": "0.2.0",
    "inputs": [
      {
        "key": "tool_port",
        "label": "Selected ESP32",
        "type": "file/path",
        "description": "Connected ESP32 board that should run the Z calibration routine.",
        "required": true,
        "default": "/dev/ttyUSB1",
        "placeholder": "/dev/ttyUSB1"
      },
      {
        "key": "z_left_track_length_cm",
        "label": "Left Z Track Length (cm)",
        "type": "number",
        "description": "Physical usable left Z travel from origin to max limit in centimeters.",
        "required": true,
        "default": 40
      },
      {
        "key": "z_right_track_length_cm",
        "label": "Right Z Track Length (cm)",
        "type": "number",
        "description": "Physical usable right Z travel from origin to max limit in centimeters.",
        "required": true,
        "default": 40
      },
      {
        "key": "calibration_speed_profile",
        "label": "Calibration Speed",
        "type": "select",
        "description": "Speed preset used while probing the Z limits.",
        "required": true,
        "default": "safe",
        "options": [
          {
            "label": "Safe",
            "value": "safe"
          },
          {
            "label": "Normal",
            "value": "normal"
          }
        ]
      }
    ],
    "advanced_inputs": [
      {
        "key": "z_left_step_pin",
        "label": "Left Z Step Pin",
        "type": "number",
        "description": "Runtime GPIO step pin for the left Z axis driver.",
        "required": false,
        "default": 32,
        "advanced": true
      },
      {
        "key": "z_left_dir_pin",
        "label": "Left Z Dir Pin",
        "type": "number",
        "description": "Runtime GPIO direction pin for the left Z axis driver.",
        "required": false,
        "default": 33,
        "advanced": true
      },
      {
        "key": "z_right_step_pin",
        "label": "Right Z Step Pin",
        "type": "number",
        "description": "Runtime GPIO step pin for the right Z axis driver.",
        "required": false,
        "default": 4,
        "advanced": true
      },
      {
        "key": "z_right_dir_pin",
        "label": "Right Z Dir Pin",
        "type": "number",
        "description": "Runtime GPIO direction pin for the right Z axis driver.",
        "required": false,
        "default": 5,
        "advanced": true
      },
      {
        "key": "limit_switch_mode",
        "label": "Limit Switch Layout",
        "type": "select",
        "description": "Choose whether the Z gantry uses 2 shared/home switches or 4 independent end-stop switches.",
        "required": false,
        "default": "4",
        "advanced": true,
        "options": [
          {
            "label": "2 Limit Switches",
            "value": "2"
          },
          {
            "label": "4 Limit Switches",
            "value": "4"
          }
        ]
      },
      {
        "key": "z_left_min_limit_pin",
        "label": "Left Z Min Limit Pin",
        "type": "number",
        "description": "GPIO pin for the left Z minimum/home limit switch.",
        "required": false,
        "default": 12,
        "advanced": true
      },
      {
        "key": "z_left_max_limit_pin",
        "label": "Left Z Max Limit Pin",
        "type": "number",
        "description": "GPIO pin for the left Z maximum limit switch.",
        "required": false,
        "default": 13,
        "advanced": true
      },
      {
        "key": "z_right_min_limit_pin",
        "label": "Right Z Min Limit Pin",
        "type": "number",
        "description": "GPIO pin for the right Z minimum/home limit switch.",
        "required": false,
        "default": 14,
        "advanced": true
      },
      {
        "key": "z_right_max_limit_pin",
        "label": "Right Z Max Limit Pin",
        "type": "number",
        "description": "GPIO pin for the right Z maximum limit switch.",
        "required": false,
        "default": 15,
        "advanced": true
      }
    ],
    "outputs": [
      {
        "key": "next",
        "label": "Next",
        "type": "flow",
        "description": "Continue when Z calibration completes."
      }
    ],
    "hardware_devices": [
      {
        "id": "left-z-motor",
        "name": "Left Z Motor",
        "kind": "stepper_motor",
        "board_id": "ttyUSB1",
        "basic_block_id": "basic-stepper-left-z-motor",
        "pins": [
          {
            "id": "z-left-dir",
            "signal": "direction",
            "function_input_key": "z_left_dir_pin"
          },
          {
            "id": "z-left-step",
            "signal": "step",
            "function_input_key": "z_left_step_pin"
          },
          {
            "id": "z-left-enable",
            "signal": "enable",
            "gpio": "-"
          },
          {
            "id": "z-left-ms1",
            "signal": "micro_step_1",
            "gpio": "-"
          },
          {
            "id": "z-left-ms2",
            "signal": "micro_step_2",
            "gpio": "-"
          },
          {
            "id": "z-left-ms3",
            "signal": "micro_step_3",
            "gpio": "-"
          }
        ]
      },
      {
        "id": "right-z-motor",
        "name": "Right Z Motor",
        "kind": "stepper_motor",
        "board_id": "ttyUSB1",
        "basic_block_id": "basic-stepper-right-z-motor",
        "pins": [
          {
            "id": "z-right-dir",
            "signal": "direction",
            "function_input_key": "z_right_dir_pin"
          },
          {
            "id": "z-right-step",
            "signal": "step",
            "function_input_key": "z_right_step_pin"
          },
          {
            "id": "z-right-enable",
            "signal": "enable",
            "gpio": "-"
          },
          {
            "id": "z-right-ms1",
            "signal": "micro_step_1",
            "gpio": "-"
          },
          {
            "id": "z-right-ms2",
            "signal": "micro_step_2",
            "gpio": "-"
          },
          {
            "id": "z-right-ms3",
            "signal": "micro_step_3",
            "gpio": "-"
          }
        ]
      },
      {
        "id": "z-left-min-limit-switch",
        "name": "Left Z Min Limit Switch",
        "kind": "sensor",
        "sensor_kind": "position_limit_switch",
        "board_id": "ttyUSB1",
        "basic_block_id": "basic-sensor-z-left-min-limit-switch",
        "pins": [
          {
            "id": "z-left-min-limit",
            "signal": "signal",
            "function_input_key": "z_left_min_limit_pin"
          }
        ]
      },
      {
        "id": "z-left-max-limit-switch",
        "name": "Left Z Max Limit Switch",
        "kind": "sensor",
        "sensor_kind": "position_limit_switch",
        "board_id": "ttyUSB1",
        "basic_block_id": "basic-sensor-z-left-max-limit-switch",
        "pins": [
          {
            "id": "z-left-max-limit",
            "signal": "signal",
            "function_input_key": "z_left_max_limit_pin"
          }
        ]
      },
      {
        "id": "z-right-min-limit-switch",
        "name": "Right Z Min Limit Switch",
        "kind": "sensor",
        "sensor_kind": "position_limit_switch",
        "board_id": "ttyUSB1",
        "basic_block_id": "basic-sensor-z-right-min-limit-switch",
        "pins": [
          {
            "id": "z-right-min-limit",
            "signal": "signal",
            "function_input_key": "z_right_min_limit_pin"
          }
        ]
      },
      {
        "id": "z-right-max-limit-switch",
        "name": "Right Z Max Limit Switch",
        "kind": "sensor",
        "sensor_kind": "position_limit_switch",
        "board_id": "ttyUSB1",
        "basic_block_id": "basic-sensor-z-right-max-limit-switch",
        "pins": [
          {
            "id": "z-right-max-limit",
            "signal": "signal",
            "function_input_key": "z_right_max_limit_pin"
          }
        ]
      }
    ]
  },
  "firmware_entry_file": "firmware/main.ino",
  "protocol": "Serial commands: SET Z PINS, SET Z LIMITS, CALIBRATE Z <leftCm> <rightCm> <speedProfile>.",
  "notes": "Homes the two Z axes to their minimum switches, optionally probes max switches, and records the usable travel."
}
