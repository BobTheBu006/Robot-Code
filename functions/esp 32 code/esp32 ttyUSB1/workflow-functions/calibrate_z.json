                                             {
                                                 "key":  "z_right_dir_pin",
                                                 "label":  "Right Z Dir Pin",
                                                 "type":  "number",
                                                 "description":  "Runtime GPIO direction pin for the right Z axis driver.",
                                                 "required":  false,
                                                 "default":  5,
                                                 "advanced":  true
