{
  "manifest": {
    "id": "calibrate_xy",
    "display_name": "Calibrate Gantry XY",
    "category": "Robot Actions",
    "description": "Define the CoreXY work-area boundaries by double-probing X min/max first, returning to X=0, then double-probing Y min/max at X=0.",
    "version": "0.2.0",
    "inputs": [
      {
        "key": "tool_port",
        "label": "Selected ESP32",
        "type": "file/path",
        "description": "Connected ESP32 board that should run the XY calibration routine.",
        "required": true,
        "default": "/dev/ttyUSB0",
        "placeholder": "/dev/ttyUSB0"
      },
      {
        "key": "x_track_length_cm",
        "label": "X Track Length (cm)",
        "type": "number",
        "description": "CoreXY X workspace length in cm. Nominal robot length is 115 cm from the back-bottom-left origin.",
        "required": true,
        "default": 115
      },
      {
        "key": "y_track_length_cm",
        "label": "Y Track Length (cm)",
        "type": "number",
        "description": "CoreXY Y workspace width in cm. Nominal robot width is 60 cm from the back-bottom-left origin.",
        "required": true,
        "default": 60
      },
      {
        "key": "speed_rpm",
        "label": "Calibration Speed (RPM)",
        "type": "number",
        "description": "Numeric motor speed used while probing limits.",
        "required": true,
        "default": 100
      },
      {
        "key": "trapezoidal_speed",
        "label": "Trapezoidal Speed",
        "type": "boolean",
        "description": "Enable acceleration and deceleration ramping instead of jumping directly to target speed.",
        "required": false,
        "default": true
      },
      {
        "key": "acceleration_rpm_per_s",
        "label": "Acceleration (RPM/s)",
        "type": "number",
        "description": "Acceleration and deceleration rate used for trapezoidal speed ramping.",
        "required": false,
        "default": 300
      }
    ],
    "advanced_inputs": [
      {
        "key": "x_step_pin",
        "label": "X Step Pin",
        "type": "number",
        "description": "Runtime GPIO step pin for the X axis driver.",
        "required": false,
        "default": 16,
        "advanced": true
      },
      {
        "key": "x_dir_pin",
        "label": "X Dir Pin",
        "type": "number",
        "description": "Runtime GPIO direction pin for the X axis driver.",
        "required": false,
        "default": 17,
        "advanced": true
      },
      {
        "key": "y_step_pin",
        "label": "Y Step Pin",
        "type": "number",
        "description": "Runtime GPIO step pin for the Y axis driver.",
        "required": false,
        "default": 18,
        "advanced": true
      },
      {
        "key": "y_dir_pin",
        "label": "Y Dir Pin",
        "type": "number",
        "description": "Runtime GPIO direction pin for the Y axis driver.",
        "required": false,
        "default": 19,
        "advanced": true
      },
      {
        "key": "motor_a_step_multiplier",
        "label": "Motor A Step Multiplier",
        "type": "number",
        "description": "Multiplier applied to CoreXY motor A step pulses. Use 2.0 when motor A needs twice as many step pulses as motor B for X-only motion.",
        "required": false,
        "default": 2.0,
        "placeholder": null,
        "advanced": true,
        "options": []
      },
      {
        "key": "limit_switch_mode",
        "label": "Limit Switch Layout",
        "type": "select",
        "description": "Choose whether the XY gantry uses 2 shared/home switches or 4 end-stop switches.",
        "required": false,
        "default": "4",
        "advanced": true,
        "options": [
          {
            "label": "2 Limit Switches",
            "value": "2"
          },
          {
            "label": "4 Limit Switches",
            "value": "4"
          }
        ]
      },
      {
        "key": "x_min_limit_pin",
        "label": "X Min Limit Pin",
        "type": "number",
        "description": "GPIO pin for the X minimum/home limit switch.",
        "required": false,
        "default": 21,
        "advanced": true
      },
      {
        "key": "x_max_limit_pin",
        "label": "X Max Limit Pin",
        "type": "number",
        "description": "GPIO pin for the X maximum limit switch.",
        "required": false,
        "default": 22,
        "advanced": true
      },
      {
        "key": "y_min_limit_pin",
        "label": "Y Min Limit Pin",
        "type": "number",
        "description": "GPIO pin for the Y minimum/home limit switch.",
        "required": false,
        "default": 23,
        "advanced": true
      },
      {
        "key": "y_max_limit_pin",
        "label": "Y Max Limit Pin",
        "type": "number",
        "description": "GPIO pin for the Y maximum limit switch.",
        "required": false,
        "default": 25,
        "advanced": true
      }
    ],
    "outputs": [
      {
        "key": "next",
        "label": "Next",
        "type": "flow",
        "description": "Continue when XY calibration completes."
      }
    ],
    "hardware_devices": [
      {
        "id": "x-axis-motor",
        "name": "CoreXY A Motor",
        "kind": "stepper_motor",
        "board_id": "ttyUSB0",
        "basic_block_id": "basic-stepper-x-axis-motor",
        "pins": [
          {
            "id": "x-dir",
            "signal": "direction",
            "function_input_key": "x_dir_pin"
          },
          {
            "id": "x-step",
            "signal": "step",
            "function_input_key": "x_step_pin"
          },
          {
            "id": "x-enable",
            "signal": "enable",
            "gpio": "-"
          },
          {
            "id": "x-ms1",
            "signal": "micro_step_1",
            "gpio": "-"
          },
          {
            "id": "x-ms2",
            "signal": "micro_step_2",
            "gpio": "-"
          },
          {
            "id": "x-ms3",
            "signal": "micro_step_3",
            "gpio": "-"
          }
        ]
      },
      {
        "id": "y-axis-motor",
        "name": "CoreXY B Motor",
        "kind": "stepper_motor",
        "board_id": "ttyUSB0",
        "basic_block_id": "basic-stepper-y-axis-motor",
        "pins": [
          {
            "id": "y-dir",
            "signal": "direction",
            "function_input_key": "y_dir_pin"
          },
          {
            "id": "y-step",
            "signal": "step",
            "function_input_key": "y_step_pin"
          },
          {
            "id": "y-enable",
            "signal": "enable",
            "gpio": "-"
          },
          {
            "id": "y-ms1",
            "signal": "micro_step_1",
            "gpio": "-"
          },
          {
            "id": "y-ms2",
            "signal": "micro_step_2",
            "gpio": "-"
          },
          {
            "id": "y-ms3",
            "signal": "micro_step_3",
            "gpio": "-"
          }
        ]
      },
      {
        "id": "x-min-limit-switch",
        "name": "X Min Limit Switch",
        "kind": "sensor",
        "sensor_kind": "position_limit_switch",
        "board_id": "ttyUSB0",
        "basic_block_id": "basic-sensor-x-min-limit-switch",
        "pins": [
          {
            "id": "x-min-limit",
            "signal": "signal",
            "function_input_key": "x_min_limit_pin"
          }
        ]
      },
      {
        "id": "x-max-limit-switch",
        "name": "X Max Limit Switch",
        "kind": "sensor",
        "sensor_kind": "position_limit_switch",
        "board_id": "ttyUSB0",
        "basic_block_id": "basic-sensor-x-max-limit-switch",
        "pins": [
          {
            "id": "x-max-limit",
            "signal": "signal",
            "function_input_key": "x_max_limit_pin"
          }
        ]
      },
      {
        "id": "y-min-limit-switch",
        "name": "Y Min Limit Switch",
        "kind": "sensor",
        "sensor_kind": "position_limit_switch",
        "board_id": "ttyUSB0",
        "basic_block_id": "basic-sensor-y-min-limit-switch",
        "pins": [
          {
            "id": "y-min-limit",
            "signal": "signal",
            "function_input_key": "y_min_limit_pin"
          }
        ]
      },
      {
        "id": "y-max-limit-switch",
        "name": "Y Max Limit Switch",
        "kind": "sensor",
        "sensor_kind": "position_limit_switch",
        "board_id": "ttyUSB0",
        "basic_block_id": "basic-sensor-y-max-limit-switch",
        "pins": [
          {
            "id": "y-max-limit",
            "signal": "signal",
            "function_input_key": "y_max_limit_pin"
          }
        ]
      }
    ],
    "schema_version": 1,
    "firmware_requirements": [
      {
        "routine_id": "calibrate_xy",
        "controller_role": "builder_board",
        "source": "firmware/main.ino",
        "protocol": "Serial commands: SET XY PINS <coreAStep> <coreADir> <coreBStep> <coreBDir> <motorAStepMultiplier>, SET XY LIMITS, CALIBRATE XY <xCm> <yCm> <speedRpm> <trapezoidFlag> <accelerationRpmPerSecond>. Firmware probes X min/max, then Y min/max at X=0, with a fast touch followed by a slow touch.",
        "entry_point": "calibrate_xy",
        "required_device_ids": [
          "x-axis-motor",
          "y-axis-motor",
          "x-min-limit-switch",
          "x-max-limit-switch",
          "y-min-limit-switch",
          "y-max-limit-switch"
        ],
        "description": "Firmware routine required by Calibrate Gantry XY."
      }
    ]
  },
  "firmware_entry_file": "firmware/main.ino",
  "protocol": "Serial commands: SET XY PINS <coreAStep> <coreADir> <coreBStep> <coreBDir> <motorAStepMultiplier>, SET XY LIMITS, CALIBRATE XY <xCm> <yCm> <speedRpm> <trapezoidFlag> <accelerationRpmPerSecond>.",
  "notes": "Homes XY to the minimum switches, optionally probes max switches, and records workspace lengths.",
  "schema_version": 1,
  "inputs": [],
  "version": "0.3.0"
}
