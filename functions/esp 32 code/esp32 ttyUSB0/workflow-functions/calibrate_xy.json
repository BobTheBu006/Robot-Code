{
  "manifest": {
    "schema_version": 1,
    "id": "calibrate_xy",
    "display_name": "Calibrate Gantry XY",
    "category": "Robot Actions",
    "description": "First-pass X-only CoreXY calibration. Move toward X min until the X-min switch trips, then move toward X max until the X-max switch trips, and measure X steps per centimeter from the entered track length.",
    "version": "0.4.0",
    "inputs": [
      {
        "key": "tool_port",
        "label": "Selected ESP32",
        "type": "file/path",
        "description": "Connected ESP32 board that should run the X calibration routine.",
        "required": true,
        "default": "/dev/ttyUSB0",
        "placeholder": "/dev/ttyUSB0",
        "advanced": false,
        "options": []
      },
      {
        "key": "x_track_length_cm",
        "label": "X Track Length (cm)",
        "type": "number",
        "description": "Physical X travel in cm between the X-min and X-max limit switches.",
        "required": true,
        "default": 104.5,
        "placeholder": null,
        "advanced": false,
        "options": []
      },
      {
        "key": "y_track_length_cm",
        "label": "Y Track Length (cm)",
        "type": "number",
        "description": "Physical Y travel in cm. Y is not probed; the gantry is assumed parked at Y = this value (Y max) when calibration runs.",
        "required": true,
        "default": 55.5,
        "placeholder": null,
        "advanced": false,
        "options": []
      },
      {
        "key": "speed_rpm",
        "label": "Calibration Speed (RPM)",
        "type": "number",
        "description": "Numeric motor speed used while probing X limits.",
        "required": true,
        "default": 100.0,
        "placeholder": null,
        "advanced": false,
        "options": []
      },
      {
        "key": "trapezoidal_speed",
        "label": "Trapezoidal Speed",
        "type": "boolean",
        "description": "Enable acceleration and deceleration ramping instead of jumping directly to target speed.",
        "required": false,
        "default": true,
        "placeholder": null,
        "advanced": false,
        "options": []
      },
      {
        "key": "acceleration_rpm_per_s",
        "label": "Acceleration (RPM/s)",
        "type": "number",
        "description": "Acceleration and deceleration rate used for trapezoidal speed ramping.",
        "required": false,
        "default": 300.0,
        "placeholder": null,
        "advanced": false,
        "options": []
      },
      {
        "key": "steps_per_rotation",
        "label": "Steps per Rotation",
        "type": "number",
        "description": "Stepper pulse count for one full motor rotation. Use 800 when the driver is configured for 800 steps per rotation.",
        "required": true,
        "default": 800.0,
        "placeholder": null,
        "advanced": false,
        "options": []
      },
      {
        "key": "max_probe_rotations",
        "label": "Max Probe Rotations",
        "type": "number",
        "description": "Maximum motor rotations allowed for each X limit-switch probe before calibration stops with a safety error.",
        "required": true,
        "default": 120.0,
        "placeholder": null,
        "advanced": false,
        "options": []
      }
    ],
    "advanced_inputs": [
      {
        "key": "x_step_pin",
        "label": "CoreXY A Step Pin",
        "type": "number",
        "description": "Runtime GPIO step pin for the CoreXY A driver.",
        "required": false,
        "default": 16.0,
        "placeholder": null,
        "advanced": true,
        "options": []
      },
      {
        "key": "x_dir_pin",
        "label": "CoreXY A Dir Pin",
        "type": "number",
        "description": "Runtime GPIO direction pin for the CoreXY A driver.",
        "required": false,
        "default": 17.0,
        "placeholder": null,
        "advanced": true,
        "options": []
      },
      {
        "key": "y_step_pin",
        "label": "CoreXY B Step Pin",
        "type": "number",
        "description": "Runtime GPIO step pin for the CoreXY B driver.",
        "required": false,
        "default": 18.0,
        "placeholder": null,
        "advanced": true,
        "options": []
      },
      {
        "key": "y_dir_pin",
        "label": "CoreXY B Dir Pin",
        "type": "number",
        "description": "Runtime GPIO direction pin for the CoreXY B driver.",
        "required": false,
        "default": 19.0,
        "placeholder": null,
        "advanced": true,
        "options": []
      },
      {
        "key": "x_min_limit_pin",
        "label": "X Min Limit Pin",
        "type": "number",
        "description": "GPIO pin for the X minimum/home limit switch.",
        "required": false,
        "default": 21.0,
        "placeholder": null,
        "advanced": true,
        "options": []
      },
      {
        "key": "x_max_limit_pin",
        "label": "X Max Limit Pin",
        "type": "number",
        "description": "GPIO pin for the X maximum limit switch.",
        "required": false,
        "default": 22.0,
        "placeholder": null,
        "advanced": true,
        "options": []
      }
    ],
    "outputs": [
