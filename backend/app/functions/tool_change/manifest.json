{
  "schema_version": 1,
  "id": "tool_change",
  "display_name": "Tool Change",
  "category": "Robot Actions",
  "description": "Pick up or drop a tool from one of six rack slots along the top-left edge of the work area.",
  "version": "0.1.0",
  "inputs": [
    {
      "key": "tool_port",
      "label": "Selected ESP32",
      "type": "file/path",
      "description": "Connected gantry ESP32 board that should run the tool-change moves.",
      "required": true,
      "default": "/dev/ttyUSB1",
      "placeholder": "/dev/ttyUSB1",
      "advanced": false,
      "options": []
    },
    {
      "key": "action",
      "label": "Action",
      "type": "select",
      "description": "Choose whether to pick up or drop the selected tool.",
      "required": true,
      "default": "get_tool",
      "placeholder": null,
      "advanced": false,
      "options": [
        {
          "label": "Get tool",
          "value": "get_tool"
        },
        {
          "label": "Drop tool",
          "value": "drop_tool"
        }
      ]
    },
    {
      "key": "slot",
      "label": "Tool Slot",
      "type": "select",
      "description": "Rack slot to use. Defaults are 10 cm apart with a 5 cm edge buffer.",
      "required": true,
      "default": "1",
      "placeholder": null,
      "advanced": false,
      "options": [
        {
          "label": "Slot 1",
          "value": "1"
        },
        {
          "label": "Slot 2",
          "value": "2"
        },
        {
          "label": "Slot 3",
          "value": "3"
        },
        {
          "label": "Slot 4",
          "value": "4"
        },
        {
          "label": "Slot 5",
          "value": "5"
        },
        {
          "label": "Slot 6",
          "value": "6"
        }
      ]
    },
    {
      "key": "speed_profile",
      "label": "Speed Profile",
      "type": "select",
      "description": "Named speed preset for the tool-change motion.",
      "required": true,
      "default": "slow",
      "placeholder": null,
      "advanced": false,
      "options": [
        {
          "label": "Slow",
          "value": "slow"
        },
        {
          "label": "Normal",
          "value": "normal"
        },
        {
          "label": "Fast",
          "value": "fast"
        }
      ]
    }
  ],
  "advanced_inputs": [
    {
      "key": "lateral_offset_cm",
      "label": "Left / Right Offset (cm)",
      "type": "number",
      "description": "Distance moved left into the rack and right back out.",
      "required": true,
      "default": 2.0,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "backoff_y_cm",
      "label": "Back Offset (cm)",
      "type": "number",
      "description": "Distance moved backward after entering the slot.",
      "required": true,
      "default": 2.0,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "slot_1_x_cm",
      "label": "Slot 1 X (cm)",
      "type": "number",
      "description": "Editable X coordinate for tool slot 1.",
      "required": true,
      "default": 2.0,
      "placeholder": null,
      "advanced": true,
      "options": []
