      "label": "Next",
      "type": "flow",
      "description": "Continue when the tool change sequence completes."
    }
  ],
  "hardware_devices": [
    {
      "id": "x-axis-motor",
      "name": "CoreXY A Motor",
      "kind": "stepper_motor",
      "board_id": "ttyUSB1",
      "pins": [
        {
          "id": "x-dir",
          "signal": "direction",
          "gpio": null,
          "function_input_key": "x_dir_pin"
        },
        {
          "id": "x-step",
          "signal": "step",
          "gpio": null,
          "function_input_key": "x_step_pin"
        }
      ],
      "basic_block_id": "basic-stepper-x-axis-motor"
    },
    {
      "id": "y-axis-motor",
      "name": "CoreXY B Motor",
      "kind": "stepper_motor",
      "board_id": "ttyUSB1",
      "pins": [
        {
          "id": "y-dir",
          "signal": "direction",
          "gpio": null,
          "function_input_key": "y_dir_pin"
        },
        {
          "id": "y-step",
          "signal": "step",
          "gpio": null,
          "function_input_key": "y_step_pin"
        }
      ],
      "basic_block_id": "basic-stepper-y-axis-motor"
    }
  ],
  "firmware_requirements": [
    {
      "routine_id": "tool_change",
      "controller_role": "builder_board",
      "source": "firmware/main.ino",
      "protocol": "serial-text",
      "entry_point": "tool_change_sequence",
      "required_device_ids": [
        "x-axis-motor",
        "y-axis-motor"
      ],
      "description": "Gantry firmware must support CoreXY XY motion commands used by the tool-change sequence."
    }
  ],
  "builder_board_id": "ttyUSB1",
  "builder_source_path": null,
