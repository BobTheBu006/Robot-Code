{
  "schema_version": 1,
  "id": "test_motor",
  "display_name": "Test Motor A/B",
  "category": "Robot Actions",
  "description": "Diagnostic: pulse a single CoreXY motor on its own to identify which physical motor is A and which is B. Because CoreXY couples both motors, driving one alone moves the carriage diagonally rather than along an axis. Stops if any limit switch trips. This move is not position-tracked, so it drops the gantry calibration - re-run Calibrate Gantry XY afterwards.",
  "version": "0.1.1",
  "inputs": [
    {
      "key": "tool_port",
      "label": "Selected ESP32",
      "type": "file/path",
      "description": "Connected ESP32 board that drives the CoreXY gantry.",
      "required": true,
      "default": "/dev/ttyUSB0",
      "placeholder": "/dev/ttyUSB0",
      "advanced": false,
      "options": [],
      "min": null,
      "max": null
    },
    {
      "key": "motor",
      "label": "Motor",
      "type": "select",
      "description": "Which CoreXY motor to pulse on its own.",
      "required": true,
      "default": "A",
      "placeholder": null,
      "advanced": false,
      "min": null,
      "max": null,
      "options": [
        {
          "label": "Motor A (CoreXY A)",
          "value": "A"
        },
        {
          "label": "Motor B (CoreXY B)",
          "value": "B"
        }
      ]
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "number",
      "description": "How many step pulses to send. 2000 is about 2.5 turns at 800 steps/rotation.",
      "required": true,
      "default": 2000.0,
      "placeholder": null,
      "advanced": false,
      "min": 1.0,
      "max": null,
      "options": []
    },
    {
      "key": "forward",
      "label": "Forward",
      "type": "boolean",
      "description": "Direction of rotation. Run it both ways to confirm the motor reverses.",
      "required": false,
      "default": true,
      "placeholder": null,
      "advanced": false,
      "min": null,
      "max": null,
      "options": []
    },
    {
      "key": "speed_rpm",
      "label": "Speed (RPM)",
      "type": "number",
      "description": "Deliberately slow by default so the motor is easy to watch.",
      "required": true,
      "default": 60.0,
      "placeholder": null,
      "advanced": false,
      "min": 1.0,
      "max": null,
      "options": []
    }
  ],
  "advanced_inputs": [
    {
      "key": "x_step_pin",
      "label": "CoreXY A Step Pin",
      "type": "number",
      "description": "Runtime GPIO step pin for the CoreXY A driver.",
      "required": false,
      "default": 25,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "x_dir_pin",
      "label": "CoreXY A Dir Pin",
      "type": "number",
      "description": "Runtime GPIO direction pin for the CoreXY A driver.",
      "required": false,
      "default": 26,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "y_step_pin",
      "label": "CoreXY B Step Pin",
      "type": "number",
      "description": "Runtime GPIO step pin for the CoreXY B driver.",
      "required": false,
      "default": 27,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "y_dir_pin",
      "label": "CoreXY B Dir Pin",
      "type": "number",
      "description": "Runtime GPIO direction pin for the CoreXY B driver.",
      "required": false,
      "default": 14,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "x_min_limit_pin",
      "label": "X Min Limit Pin",
      "type": "number",
      "description": "GPIO pin for the X minimum/home limit switch.",
      "required": false,
      "default": 16,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "x_max_limit_pin",
      "label": "X Max Limit Pin",
      "type": "number",
      "description": "GPIO pin for the X maximum limit switch.",
      "required": false,
      "default": 17,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "y_min_limit_pin",
      "label": "Y Min Limit Pin",
      "type": "number",
      "description": "GPIO pin for the Y minimum limit switch.",
      "required": false,
      "default": 4,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "y_max_limit_pin",
      "label": "Y Max Limit Pin",
      "type": "number",
      "description": "GPIO pin reserved for a Y maximum limit switch. This machine has no Y-max switch wired; the pin is held inactive by its pull-up and never blocks a move. The usable Y range is bounded by the Y track length and the 5 mm buffers instead. Optional: -1 means no Y-max limit switch is wired.",
      "required": false,
      "default": -1.0,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "gantry_enable_pin",
      "label": "Shared Driver Enable Pin",
      "type": "number",
      "description": "Shared XY enable GPIO, resolved from the Hardware Map.",
      "required": false,
      "default": 13,
      "advanced": true,
      "min": -1,
      "options": []
    }
  ],
  "outputs": [
    {
      "key": "next",
      "label": "Next",
      "type": "flow",
      "description": "Continue when the motor test completes."
    }
  ],
