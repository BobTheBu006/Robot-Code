{
  "schema_version": 1,
  "id": "move_gantry_xy",
  "display_name": "Move Gantry XY",
  "category": "Robot Actions",
  "description": "Move the CoreXY gantry in a straight line from its current position to an absolute (X, Y) position in cm, with trapezoidal acceleration. Requires a prior Calibrate Gantry XY run (X steps-per-cm is reused for Y). Coordinates are inset by a 5 mm buffer from each limit switch: 0 is the safe min end and the max is the track length minus the buffers. Errors and stops immediately if the target is outside the usable range or a limit switch is hit.",
  "version": "0.2.0",
  "inputs": [
    {
      "key": "tool_port",
      "label": "Selected ESP32",
      "type": "file/path",
      "description": "Connected ESP32 board that drives the CoreXY gantry.",
      "required": true,
      "default": "/dev/ttyUSB0",
      "placeholder": "/dev/ttyUSB0",
      "advanced": false,
      "options": []
    },
    {
      "key": "x_cm",
      "label": "Target X (cm)",
      "type": "number",
      "description": "Absolute X position in cm. 0 is the safe X-min end (5 mm off the switch); the max is the X track length minus the 5 mm buffer at each end.",
      "required": true,
      "default": 0.0,
      "placeholder": null,
      "advanced": false,
      "min": 0.0,
      "max": 105.3,
      "options": []
    },
    {
      "key": "y_cm",
      "label": "Target Y (cm)",
      "type": "number",
      "description": "Absolute Y position in cm. 0 is the safe Y-min end (5 mm off the switch); the max is the Y track length minus the 5 mm buffer at each end.",
      "required": true,
      "default": 0.0,
      "placeholder": null,
      "advanced": false,
      "min": 0.0,
      "max": 54.1,
      "options": []
    },
    {
      "key": "speed_rpm",
      "label": "Move Speed (RPM)",
      "type": "number",
      "description": "Numeric target motor speed for the move.",
      "required": true,
      "default": 400.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "trapezoidal_speed",
      "label": "Trapezoidal Speed",
      "type": "boolean",
      "description": "Ramp acceleration and deceleration instead of jumping straight to target speed.",
      "required": false,
      "default": true,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "acceleration_rpm_per_s",
      "label": "Acceleration (RPM/s)",
      "type": "number",
      "description": "Acceleration and deceleration rate used for trapezoidal speed ramping.",
      "required": false,
      "default": 600.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    }
  ],
