{
  "schema_version": 1,
  "id": "deepwell_handling",
  "display_name": "Deepwell Handling",
  "category": "Robot Actions",
  "description": "Moves a deepwell's lid or the whole deepwell plate with the gripper. The 24 wells sit on the right Z platform (columns A-D along X, rows 1-6 along Y; positions from Teach Deepwell Positions). Take: the right Z lifts the object into the open claws, they grip, the right Z lowers, the gantry carries it to the target, the left Z lifts to the target height, the claws release and the left Z lowers. Put back is the same in reverse. Picks up the gripper first if it is not on the head. Claw angles and grab heights for the lid and the plate are in the advanced settings and must be set before the first run.",
  "version": "1.0.0",
  "inputs": [
    {
      "key": "action",
      "label": "Action",
      "type": "select",
      "description": "What to move, and which way.",
      "required": true,
      "default": "take_lid",
      "placeholder": null,
      "advanced": false,
      "min": null,
      "max": null,
      "options": [
        {
          "label": "Take lid off",
          "value": "take_lid"
        },
        {
          "label": "Put lid back on",
          "value": "put_lid"
        },
        {
          "label": "Take deepwell to target",
