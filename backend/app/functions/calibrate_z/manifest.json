{
  "schema_version": 1,
  "id": "calibrate_z",
  "display_name": "Calibrate Z Axis",
  "category": "Robot Actions",
  "description": "Homes both Z motors independently: each side drives down to its min limit switch (sets 0), then up to its max limit switch, using the entered track length as the expected travel. The actual measured travel becomes the calibrated range for later Move Z Axis calls.",
