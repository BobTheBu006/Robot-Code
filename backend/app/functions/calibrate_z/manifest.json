{
  "schema_version": 1,
  "id": "calibrate_z",
  "display_name": "Calibrate Gantry Z",
  "category": "Robot Actions",
  "description": "Define the Z work-area boundaries by double-probing both Z motors against min and max limit switches.",
  "version": "0.2.0",
  "inputs": [
    {
      "key": "tool_port",
      "label": "Selected ESP32",
      "type": "file/path",
      "description": "Connected ESP32 board that should run the Z calibration routine.",
      "required": true,
      "default": "/dev/ttyUSB1",
      "placeholder": "/dev/ttyUSB1",
      "advanced": false,
      "options": []
    },
    {
      "key": "z_left_track_length_cm",
      "label": "Z Track Length (cm)",
      "type": "number",
      "description": "Single Z workspace height in cm. Nominal robot height is 60 cm from the back-bottom-left origin.",
      "required": true,
      "default": 60.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "z_right_track_length_cm",
      "label": "Right Z Track Length (cm)",
      "type": "number",
      "description": "Legacy dual-Z compatibility value. Single-Z setups use the same 60 cm Z height.",
      "required": true,
      "default": 60.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "speed_rpm",
      "label": "Calibration Speed (RPM)",
      "type": "number",
      "description": "Numeric motor speed used while probing limits.",
      "required": true,
      "default": 100.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "trapezoidal_speed",
      "label": "Trapezoidal Speed",
      "type": "boolean",
      "description": "Enable acceleration and deceleration ramping instead of jumping directly to target speed.",
      "required": false,
      "default": true,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "acceleration_rpm_per_s",
      "label": "Acceleration (RPM/s)",
      "type": "number",
      "description": "Acceleration and deceleration rate used for trapezoidal speed ramping.",
      "required": false,
      "default": 300.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    }
