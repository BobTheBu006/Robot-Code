{
  "schema_version": 1,
  "id": "move_gantry_z",
  "display_name": "Move Gantry Z",
  "category": "Robot Actions",
  "description": "Move the two independent Z axes to absolute positions from the calibrated origin.",
  "version": "0.2.0",
  "inputs": [
    {
      "key": "tool_port",
      "label": "Selected ESP32",
      "type": "file/path",
      "description": "Connected ESP32 board that should receive the Z-axis command.",
      "required": true,
      "default": "/dev/ttyUSB1",
      "placeholder": "/dev/ttyUSB1",
      "advanced": false,
      "options": []
    },
    {
      "key": "z_left_cm",
      "label": "Left Z Position (cm)",
      "type": "number",
      "description": "Target left Z position measured from the calibrated origin.",
      "required": true,
      "default": 0.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "z_right_cm",
      "label": "Right Z Position (cm)",
      "type": "number",
      "description": "Target right Z position measured from the calibrated origin.",
      "required": true,
      "default": 0.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "speed_rpm",
      "label": "Speed (RPM)",
      "type": "number",
      "description": "Numeric target motor speed for the move.",
      "required": true,
      "default": 240.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "trapezoidal_speed",
      "label": "Trapezoidal Speed",
      "type": "boolean",
      "description": "Enable acceleration and deceleration ramping instead of jumping directly to target speed.",
      "required": false,
      "default": true,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "acceleration_rpm_per_s",
      "label": "Acceleration (RPM/s)",
      "type": "number",
      "description": "Acceleration and deceleration rate used for trapezoidal speed ramping.",
      "required": false,
      "default": 600.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "on_the_fly_calibration",
      "label": "On-the-fly Calibration",
      "type": "boolean",
      "description": "When enabled, moves that end within 3 cm of a limit switch probe that switch and compare the observed position against calibration.",
      "required": false,
      "default": true,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "calibration_max_diff_steps",
      "label": "Max Calibration Difference (steps)",
      "type": "number",
      "description": "Maximum allowed on-the-fly limit-switch position error before a full recalibration is triggered.",
      "required": false,
      "default": 5.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    }
  ],
  "advanced_inputs": [
