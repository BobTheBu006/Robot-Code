{
  "schema_version": 1,
  "id": "run_pumps",
  "display_name": "Run Peristaltic Pumps",
  "category": "Robot Actions",
  "description": "Dispenses a volume through any of the 5 peristaltic pumps. Pumps with a non-zero volume run at the same time, each at its own speed. Volumes come from each pump's mL-per-200-steps calibration in the Hardware Map.",
