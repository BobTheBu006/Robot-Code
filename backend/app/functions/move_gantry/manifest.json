{
  "schema_version": 1,
  "id": "move_gantry",
  "display_name": "Move Gantry XYZ",
  "category": "Robot Actions",
  "description": "Move the CoreXY gantry to an absolute X/Y/Z position inside the 115 x 60 x 60 cm workspace. Origin 0,0,0 is the back-bottom-left corner.",
  "version": "0.4.0",
  "inputs": [
    {
      "key": "tool_port",
      "label": "Selected ESP32",
      "type": "file/path",
      "description": "Controller resolved from the Hardware Map for the CoreXY gantry routine.",
      "required": true,
      "default": "/dev/ttyUSB1",
      "placeholder": "/dev/ttyUSB1",
      "advanced": false,
      "options": []
    },
    {
      "key": "x_cm",
      "label": "X Position (cm)",
      "type": "number",
      "description": "Target X position in cm from the back-bottom-left origin. Range: 0 to 115 cm.",
      "required": true,
      "default": 0.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "y_cm",
      "label": "Y Position (cm)",
      "type": "number",
      "description": "Target Y position in cm from the back-bottom-left origin. Range: 0 to 60 cm.",
      "required": true,
      "default": 0.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "z_cm",
      "label": "Z Position (cm)",
      "type": "number",
      "description": "Target Z position in cm from the back-bottom-left origin. Range: 0 to 60 cm.",
      "required": true,
      "default": 0.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "speed_rpm",
      "label": "Speed (RPM)",
      "type": "number",
      "description": "Numeric target motor speed for the move.",
      "required": true,
      "default": 240.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "trapezoidal_speed",
      "label": "Trapezoidal Speed",
      "type": "boolean",
      "description": "Enable acceleration and deceleration ramping instead of jumping directly to target speed.",
      "required": false,
      "default": true,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "acceleration_rpm_per_s",
      "label": "Acceleration (RPM/s)",
      "type": "number",
      "description": "Acceleration and deceleration rate used for trapezoidal speed ramping.",
      "required": false,
      "default": 600.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "on_the_fly_calibration",
      "label": "On-the-fly Calibration",
      "type": "boolean",
      "description": "When enabled, moves that end within 3 cm of a limit switch probe that switch and compare the observed position against calibration.",
      "required": false,
      "default": true,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "calibration_max_diff_steps",
      "label": "Max Calibration Difference (steps)",
      "type": "number",
      "description": "Maximum allowed on-the-fly limit-switch position error before a full recalibration is triggered.",
      "required": false,
      "default": 5.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    }
  ],
  "advanced_inputs": [
    {
      "key": "x_step_pin",
      "label": "X Step Pin",
      "type": "number",
      "description": "Runtime GPIO step pin for the X axis driver.",
