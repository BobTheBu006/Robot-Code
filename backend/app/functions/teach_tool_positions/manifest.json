{
  "schema_version": 1,
  "id": "teach_tool_positions",
  "display_name": "Teach Tool Positions",
  "category": "Robot Actions",
  "description": "Records where each tool sits in the rack by hand. While this block runs, the XY motors switch off and a dialog opens: push the carriage to the tool, press Save, go to the next slot. The encoders track the carriage, and on Finish the gantry adopts the position it was pushed to, so the calibration survives. Saved positions become the defaults every Pick Up and Drop Toolhead block uses. Needs a calibrated gantry and working encoders.",
  "version": "1.0.0",
  "inputs": [
    {
      "key": "tool_port",
      "label": "Selected ESP32",
      "type": "file/path",
      "description": "Connected ESP32 board that drives the CoreXY gantry.",
      "required": true,
      "default": "/dev/ttyUSB0",
      "placeholder": "/dev/ttyUSB0",
      "advanced": false,
      "options": []
    },
    {
      "key": "first_slot",
      "label": "First Slot",
      "type": "number",
      "description": "Rack slot the dialog starts at.",
      "required": false,
      "default": 1,
      "placeholder": null,
      "advanced": false,
      "min": 1,
      "max": 6,
      "options": []
    },
    {
      "key": "last_slot",
      "label": "Last Slot",
      "type": "number",
      "description": "Last rack slot the dialog offers.",
      "required": false,
      "default": 6,
      "placeholder": null,
      "advanced": false,
      "min": 1,
      "max": 6,
      "options": []
    },
    {
      "key": "positions",
      "label": "Taught Positions",
      "type": "string",
      "description": "Filled in by the teach dialog; leave empty.",
      "required": false,
      "default": "",
      "placeholder": null,
      "advanced": true,
      "min": null,
      "max": null,
      "options": [],
      "hidden": true
    }
  ],
  "advanced_inputs": [
    {
      "key": "x_step_pin",
      "label": "CoreXY A Step Pin",
      "type": "number",
      "description": "Runtime GPIO step pin for the CoreXY A driver.",
      "required": false,
      "default": 25,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "x_dir_pin",
      "label": "CoreXY A Dir Pin",
      "type": "number",
      "description": "Runtime GPIO direction pin for the CoreXY A driver.",
      "required": false,
      "default": 26,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "y_step_pin",
      "label": "CoreXY B Step Pin",
      "type": "number",
      "description": "Runtime GPIO step pin for the CoreXY B driver.",
      "required": false,
      "default": 27,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "y_dir_pin",
      "label": "CoreXY B Dir Pin",
      "type": "number",
      "description": "Runtime GPIO direction pin for the CoreXY B driver.",
      "required": false,
      "default": 14,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "x_min_limit_pin",
      "label": "X Min Limit Pin",
      "type": "number",
      "description": "GPIO pin for the X minimum/home limit switch.",
      "required": false,
      "default": 16,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "x_max_limit_pin",
      "label": "X Max Limit Pin",
      "type": "number",
      "description": "GPIO pin for the X maximum limit switch.",
      "required": false,
      "default": 17,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "y_min_limit_pin",
      "label": "Y Min Limit Pin",
      "type": "number",
      "description": "GPIO pin for the Y minimum limit switch.",
      "required": false,
      "default": 4,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "y_max_limit_pin",
      "label": "Y Max Limit Pin",
      "type": "number",
      "description": "GPIO pin reserved for a Y maximum limit switch. This machine has no Y-max switch wired; the pin is held inactive by its pull-up and never blocks a move. The usable Y range is bounded by the Y track length and the 5 mm buffers instead. Optional: -1 means no Y-max limit switch is wired.",
      "required": false,
      "default": -1.0,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "gantry_enable_pin",
      "label": "Shared Driver Enable Pin",
      "type": "number",
      "description": "Shared XY enable GPIO, resolved from the Hardware Map.",
      "required": false,
      "default": 13,
      "advanced": true,
      "min": -1,
      "options": []
    }
  ],
  "outputs": [
    {
      "key": "next",
      "label": "Next",
      "type": "flow",
      "description": "Continue once the positions are saved."
    }
  ],
