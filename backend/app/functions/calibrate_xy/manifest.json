{
  "schema_version": 1,
  "id": "calibrate_xy",
  "display_name": "Calibrate Gantry XY",
  "category": "Robot Actions",
  "description": "Home the XY gantry against its limit switches and register the track lengths in centimeters.",
  "version": "0.2.0",
  "inputs": [
    {
      "key": "tool_port",
      "label": "Selected ESP32",
      "type": "file/path",
      "description": "Connected ESP32 board that should run the XY calibration routine.",
      "required": true,
      "default": "/dev/ttyUSB1",
      "placeholder": "/dev/ttyUSB1",
      "advanced": false,
      "options": []
    },
    {
      "key": "x_track_length_cm",
      "label": "X Track Length (cm)",
      "type": "number",
      "description": "Physical usable X travel from origin to max limit in centimeters.",
      "required": true,
      "default": 100.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "y_track_length_cm",
      "label": "Y Track Length (cm)",
      "type": "number",
      "description": "Physical usable Y travel from origin to max limit in centimeters.",
      "required": true,
      "default": 100.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "calibration_speed_profile",
      "label": "Calibration Speed",
      "type": "select",
      "description": "Speed preset used while probing the XY limits.",
      "required": true,
      "default": "safe",
      "placeholder": null,
      "advanced": false,
      "options": [
        {
          "label": "Safe",
          "value": "safe"
        },
        {
          "label": "Normal",
          "value": "normal"
        }
      ]
    }
  ],
  "advanced_inputs": [
