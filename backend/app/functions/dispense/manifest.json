{
  "id": "dispense",
  "display_name": "7 Syringe Dispenser",
  "category": "Robot Actions",
  "description": "Drive the 7-head syringe ESP32 with calibration-aware dispense amounts.",
  "version": "0.4.0",
  "inputs": [
    {
      "key": "tool_port",
      "label": "Selected ESP32",
      "type": "file/path",
      "description": "Serial device path for the connected ESP32 syringe board.",
      "required": false,
      "default": "/dev/ttyUSB0",
      "placeholder": "/dev/ttyUSB0",
      "advanced": false,
      "options": []
    },
    {
      "key": "calibration_file",
      "label": "Calibration File",
      "type": "file/path",
      "description": "Calibration file used to convert dispense amounts into syringe motor steps.",
      "required": true,
      "default": "/home/robot/robot control/Robot-Code/functions/syringe control code/calibration.json",
      "placeholder": "/path/to/calibration.json",
      "advanced": false,
      "options": []
    },
    {
      "key": "speed",
      "label": "Dispense Speed",
      "type": "number",
      "description": "Shared fallback speed used when dedicated expelling and intake speeds are not set.",
      "required": false,
      "default": 100.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
