{
  "schema_version": 1,
  "id": "prime_syringes",
  "display_name": "Home & Prime Syringes",
  "category": "Robot Actions",
  "description": "Establishes a known plunger position and primes all 7 pumps. The plungers have no position feedback, so every plunger is first driven in the dispense direction far enough to bottom out on the mechanical hard stop (steppers skip there by design) - that stop becomes the known zero. Then each prime cycle draws the prime volume up and pushes it back out, ending on the stop again.",
  "version": "0.2.0",
  "inputs": [
    {
      "key": "tool_port",
      "label": "ESP32 Port",
      "type": "file/path",
      "description": "Serial device path for the connected ESP32 syringe board.",
      "required": false,
      "default": "/dev/ttyUSB0",
      "placeholder": "/dev/ttyUSB0",
      "advanced": false,
      "options": []
    },
    {
      "key": "home_overtravel_ul",
      "label": "Homing Push (\u00b5l)",
      "type": "number",
      "description": "How much the plungers are over-driven in the dispense direction to guarantee they bottom out on the hard stop from any starting position. Should be at least a full syringe stroke; 1500 \u00b5l covers a 1 ml syringe with margin.",
      "required": true,
      "default": 1000.0,
      "placeholder": null,
      "advanced": false,
      "min": null,
      "max": null,
      "options": []
    },
    {
      "key": "prime_volume_ul",
      "label": "Prime Volume (\u00b5l)",
      "type": "number",
      "description": "Volume drawn up and pushed back out in each prime cycle.",
      "required": true,
      "default": 1000.0,
      "placeholder": null,
      "advanced": false,
      "min": null,
      "max": null,
      "options": []
    },
    {
      "key": "prime_cycles",
      "label": "Prime Cycles",
      "type": "number",
      "description": "How many draw/push cycles to run after homing.",
      "required": true,
      "default": 3.0,
      "placeholder": null,
      "advanced": false,
      "min": null,
      "max": null,
      "options": []
    },
    {
      "key": "final_draw_ul",
      "label": "Final Draw (\u00b5l)",
      "type": "number",
      "description": "Last move of the block: after the prime cycles the plungers pull up this much, so they finish drawn and ready to dispense instead of seated on the stop. Set 0 to skip.",
      "required": false,
      "default": 1000.0,
      "placeholder": null,
      "advanced": false,
      "min": null,
      "max": null,
      "options": []
    },
    {
      "key": "speed",
      "label": "Speed (RPM)",
      "type": "number",
      "description": "Motor speed for the homing push and every prime stroke.",
      "required": true,
      "default": 60.0,
      "placeholder": null,
      "advanced": false,
      "min": null,
      "max": null,
      "options": []
    }
  ],
  "advanced_inputs": [
