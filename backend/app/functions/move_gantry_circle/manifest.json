{
  "schema_version": 1,
  "id": "move_gantry_circle",
  "display_name": "Move Gantry Circle",
  "category": "Robot Actions",
  "description": "Trace a full circle with the CoreXY gantry around a given center (X, Y) position with a given radius, using trapezoidal acceleration over the whole lap. Moves to the circle start point first. Requires a prior Calibrate Gantry XY run. Errors and stops immediately if the circle does not fit the workspace or a limit switch is hit.",
  "version": "0.1.1",
  "inputs": [
    {
      "key": "tool_port",
      "label": "Selected ESP32",
      "type": "file/path",
      "description": "Connected ESP32 board that drives the CoreXY gantry.",
      "required": true,
      "default": "/dev/ttyUSB0",
      "placeholder": "/dev/ttyUSB0",
      "advanced": false,
      "options": []
    },
    {
      "key": "center_x_cm",
      "label": "Center X (cm)",
      "type": "number",
      "description": "Absolute X position of the circle center in cm. 0 is the safe X-min end (5 mm off the switch); the max is the X track length minus the 5 mm buffer at each end. The whole circle must also fit inside this range.",
      "required": true,
      "default": 10.0,
      "placeholder": null,
      "advanced": false,
      "min": 0.0,
      "max": 105.3,
      "options": []
    },
    {
      "key": "center_y_cm",
      "label": "Center Y (cm)",
      "type": "number",
      "description": "Absolute Y position of the circle center in cm. 0 is the safe Y-min end (5 mm off the switch); the max is the Y track length minus the 5 mm buffer at each end. The whole circle must also fit inside this range.",
      "required": true,
      "default": 10.0,
      "placeholder": null,
      "advanced": false,
      "min": 0.0,
      "max": 54.1,
      "options": []
    },
    {
      "key": "radius_cm",
      "label": "Radius (cm)",
      "type": "number",
      "description": "Circle radius in cm. The whole circle must fit inside the calibrated workspace.",
      "required": true,
      "default": 2.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "repeat_count",
      "label": "Repeat Count",
      "type": "number",
      "description": "Number of full circles to trace before continuing.",
      "required": false,
      "default": 1.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "speed_rpm",
      "label": "Move Speed (RPM)",
      "type": "number",
      "description": "Numeric target motor speed for the circle move.",
      "required": true,
      "default": 400.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "trapezoidal_speed",
      "label": "Trapezoidal Speed",
      "type": "boolean",
      "description": "Ramp acceleration and deceleration over the whole circle instead of jumping straight to target speed.",
      "required": false,
      "default": true,
      "placeholder": null,
      "advanced": false,
      "options": []
    },
    {
      "key": "acceleration_rpm_per_s",
      "label": "Acceleration (RPM/s)",
      "type": "number",
      "description": "Acceleration and deceleration rate used for trapezoidal speed ramping.",
      "required": false,
      "default": 600.0,
      "placeholder": null,
      "advanced": false,
      "options": []
    }
  ],
  "advanced_inputs": [
    {
      "key": "x_step_pin",
      "label": "CoreXY A Step Pin",
      "type": "number",
      "description": "Runtime GPIO step pin for the CoreXY A driver.",
      "required": false,
      "default": 25,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "x_dir_pin",
      "label": "CoreXY A Dir Pin",
      "type": "number",
      "description": "Runtime GPIO direction pin for the CoreXY A driver.",
      "required": false,
      "default": 26,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "y_step_pin",
      "label": "CoreXY B Step Pin",
      "type": "number",
      "description": "Runtime GPIO step pin for the CoreXY B driver.",
      "required": false,
      "default": 27,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "y_dir_pin",
      "label": "CoreXY B Dir Pin",
      "type": "number",
      "description": "Runtime GPIO direction pin for the CoreXY B driver.",
      "required": false,
      "default": 14,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "x_min_limit_pin",
      "label": "X Min Limit Pin",
      "type": "number",
      "description": "GPIO pin for the X minimum/home limit switch.",
      "required": false,
      "default": 16,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "x_max_limit_pin",
      "label": "X Max Limit Pin",
      "type": "number",
      "description": "GPIO pin for the X maximum limit switch.",
      "required": false,
      "default": 17,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "y_min_limit_pin",
      "label": "Y Min Limit Pin",
      "type": "number",
      "description": "GPIO pin for the Y minimum limit switch.",
      "required": false,
      "default": 4,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "y_max_limit_pin",
      "label": "Y Max Limit Pin",
      "type": "number",
      "description": "GPIO pin reserved for a Y maximum limit switch. This machine has no Y-max switch wired; the pin is held inactive by its pull-up and never blocks a move. The usable Y range is bounded by the Y track length and the 5 mm buffers instead. Optional: -1 means no Y-max limit switch is wired.",
      "required": false,
      "default": -1.0,
      "placeholder": null,
      "advanced": true,
      "options": []
    },
    {
      "key": "gantry_enable_pin",
      "label": "Shared Driver Enable Pin",
      "type": "number",
      "description": "Shared XY enable GPIO, resolved from the Hardware Map.",
      "required": false,
      "default": 13,
      "advanced": true,
      "min": -1,
      "options": []
    }
  ],
  "outputs": [
    {
      "key": "next",
      "label": "Next",
      "type": "flow",
      "description": "Continue when the circle move completes."
    }
  ],
